# OpenAI (LLM + embeddings for vector memory)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Tavily web search
TAVILY_API_KEY=

# Vector memory
MEMORY_TOP_K=3

# FastAPI
API_HOST=0.0.0.0
API_PORT=8010

# MCP servers: MCP_<NAME>_URL (required) + MCP_<NAME>_API_KEY (optional bearer token)
# Each distinct <NAME> becomes one MCP server, exposed to the agent as tools.
# Example:
# MCP_GITHUB_URL=https://mcp.example.com/github
# MCP_GITHUB_API_KEY=xxxxx
#
# MCP_FILESYSTEM_URL=https://mcp.example.com/fs
# MCP_FILESYSTEM_API_KEY=
