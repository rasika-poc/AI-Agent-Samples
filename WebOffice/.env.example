# Reference only — docker-compose.yml sets these directly on the api-files
# service for local dev. Copy this to .env and wire it up with env_file if you
# want to override values without editing docker-compose.yml.

DATABASE_URL=postgresql://weboffice_app:weboffice_app_dev_password@postgres:5432/weboffice
JWT_SECRET=dev-only-change-me
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=weboffice
MINIO_SECRET_KEY=weboffice_dev_secret
MINIO_BUCKET=weboffice
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_ENABLED=true
